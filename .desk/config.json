{
  "version": 1,
  "github": "munhq/cloud-tools",
  "store": "server",
  "server": {
    "url": "https://desk.munhq.com",
    "tokenEnv": "DESK_TOKEN"
  },
  "validation": [
    {
      "name": "format",
      "command": "cargo fmt --check",
      "stage": "land",
      "paths": [
        "**/*.rs",
        "Cargo.toml",
        "Cargo.lock",
        "rustfmt.toml",
        ".rustfmt.toml"
      ]
    },
    {
      "name": "buck-files",
      "command": "sh scripts/buck/sync.sh --check",
      "stage": "land",
      "paths": [
        "scripts/buck/**",
        "toolchains/**",
        "platforms/**",
        "reindeer.toml"
      ]
    }
  ],
  "preLand": [
    "cargo fmt --check"
  ]
}
